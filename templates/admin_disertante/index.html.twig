{% extends 'admin/layout-admin.html.twig' %}

{% block title %}Administrar disertantes{% endblock %}

{% block body %}
{% for mensaje in app.flashes('success') %}
    <div class="alert alert-success" role="alert">
        {{ mensaje }}
    </div>
{% endfor %}

{% for mensaje in app.flashes('danger') %}
    <div class="alert alert-danger" role="alert">
        {{ mensaje }}
    </div>
{% endfor %}
   <h1 class="mb-4">Administración de disertantes</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre completo</th>
                    <th>Email</th>
                    <th>Especialidad</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                {% for disertante in disertantes %}
                    <tr>
                        <td>{{ disertante.nombreCompleto }}</td>

                        <td>{{ disertante.email }}</td>

                        <td>
                            {{ disertante.especialidad ?? 'Sin especialidad' }}
                        </td>

                        <td>
                            {% if disertante.activo %}
                                <span class="badge bg-success">Activo</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactivo</span>
                            {% endif %}
                        </td>

                        <td>
                            <a href="{{ path('app_admin_disertante_show', {
                                'id': disertante.id
                            }) }}"
                               class="btn btn-sm btn-info">
                                Ver
                            </a>

                            <a href="{{ path('app_admin_disertante_edit', {
                                'id': disertante.id
                            }) }}"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>
                            {% include 'admin_disertante/_delete_form.html.twig' %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No hay disertantes registrados.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <a href="{{ path('app_admin_disertante_new') }}"
   class="btn btn-success mt-3">
    + Nuevo Disertante
</a>
{% endblock %}