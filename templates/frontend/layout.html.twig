{% extends 'base.html.twig' %}

{% block header %}

<div class="container mt-3">

    <h1>Sistema de Gestión de Eventos</h1>

    <nav class="mb-3">

        <a href="{{ path('app_portada') }}">Inicio</a> |

        <a href="{{ path('app_evento') }}">Eventos</a> |

        <a href="{{ path('app_disertantes') }}">Disertantes</a>

    </nav>

