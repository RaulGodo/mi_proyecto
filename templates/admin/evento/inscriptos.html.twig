{% extends 'admin/layout-admin.html.twig' %}

{% block title %}Inscriptos del evento{% endblock %}

{% block contenido %}

    <section class="py-4">

        <a href="{{ path('admin_evento_listar') }}"
           class="btn btn-outline-secondary mb-4">
            ← Volver a eventos
        </a>

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <h1 class="h3 mb-3">
                    Inscriptos del evento
                </h1>

                <h2 class="h5 text-secondary mb-4">
                    {{ evento.titulo }}
                </h2>

                <div class="alert alert-info">
                    <strong>Total de inscriptos:</strong>
                    {{ evento.usuarios|length }}
                </div>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Correo electrónico</th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for usuario in evento.usuarios %}

                                <tr>
                                    <td>{{ usuario.nombre }}</td>
                                    <td>{{ usuario.apellido }}</td>
                                    <td>{{ usuario.email }}</td>
                                </tr>

                            {% else %}

                                <tr>
                                    <td colspan="3" class="text-center text-muted">
                                        Este evento no tiene inscriptos.
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </section>

{% endblock %}