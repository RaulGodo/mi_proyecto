{% extends 'admin/evento/layout-admin.html.twig' %}

{% block title %}
    Gestión de Eventos
{% endblock %}

{% block contenido_admin %}

{% for tipo, mensajes in app.flashes %}
    {% for mensaje in mensajes %}
        <div class="alert alert-{{ tipo }}">
            {{ mensaje }}
        </div>
    {% endfor %}
{% endfor %}

<div class="mt-4">

    <h1>Gestión de Eventos</h1>

    <table class="table table-bordered table-striped">

        <thead>
        <tr>
            <th>Fecha/Hora</th>
            <th>Título</th>
            <th>Idioma</th>
            <th>Inscriptos</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
        </thead>

        <tbody>

        {% for evento in eventos %}

            <tr>

                <td>
                    {{ evento.fecha|date('d/m/Y') }}
                    {{ evento.hora|date('H:i') }}
                </td>

                <td>
                    {{ evento.titulo }}
                </td>

                <td>
                    {{ evento.idioma }}
                </td>

                <td>
                    {{ evento.usuarios|length }}
                </td>

                <td>
                    {% if evento.estado == 'Activo' %}
                        <span class="badge bg-success">Activo</span>
                    {% elseif evento.estado == 'Cancelado' %}
                        <span class="badge bg-secondary">Cancelado</span>
                    {% elseif evento.estado == 'Finalizado' %}
                        <span class="badge bg-danger">Finalizado</span>
                    {% else %}
                        <span class="badge bg-warning">Sin estado</span>
                    {% endif %}
                </td>

                <td>

                    <a
                    href="{{ path(
                    'admin_evento_inscriptos',
                    {id: evento.id}
                    ) }}"
                    class="btn btn-info btn-sm"
                    >
                        👥 Inscriptos
                    </a>

                    <a
                    href="{{ path(
                    'admin_evento_borrar',
                    {id: evento.id}
                    ) }}"
                    class="btn btn-danger btn-sm"
                    >
                        🗑️ Borrar
                    </a>
                </td>

            </tr>

        {% else %}

            <tr>
                <td colspan="6">
                    No existe ningún evento.
                </td>
            </tr>

        {% endfor %}

        </tbody>

    </table>

    <a href="#"
       class="btn btn-success">
        ➕ Nuevo Evento
    </a>

</div>

{% endblock %}