{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Nuevo evento
{% endblock %}

{% block contenido %}

    <h1>Nuevo evento</h1>

    <p>
        Complete los datos para registrar un nuevo evento.
    </p>

   {{ form_start(form) }}
    {{ form_row(form.titulo) }}
    {{ form_row(form.idioma) }}
    {{ form_row(form.descripcion) }}
    {{ form_row(form.fecha) }}
    {{ form_row(form.hora) }}
    {{ form_row(form.duracion) }}
    {{ form_row(form.capacidad) }}
    {{ form_row(form.disertante) }}

    <button type="submit" class="btn btn-primary">
        Guardar evento
    </button>

    <a href="{{ path('admin_evento_listar') }}" class="btn btn-secondary">
        Cancelar
    </a>
{{ form_end(form) }}

{% endblock %}