{% extends 'admin/evento/layout-admin.html.twig' %}

{% block title %}Gestión de Disertantes{% endblock %}

{% block contenido_admin %}

{% for tipo, mensajes in app.flashes %}
    {% for mensaje in mensajes %}
        <div class="alert alert-{{ tipo }}">{{ mensaje }}</div>
    {% endfor %}
{% endfor %}

<div class="mt-4">
    <h1>Gestión de Disertantes</h1>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Nombre completo</th>
                <th>Email</th>
                <th>Especialidad</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for disertante in disertantes %}
            <tr>
                <td>{{ disertante.nombreCompleto }}</td>
                <td>{{ disertante.email }}</td>
                <td>{{ disertante.especialidad }}</td>
                <td>
                    {% if disertante.activo %}
                        <span class="badge bg-success">Activo</span>
                    {% else %}
                        <span class="badge bg-secondary">Inactivo</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_disertante_ver', {id: disertante.id}) }}" class="btn btn-info btn-sm">👁 Ver</a>
                    <a href="{{ path('admin_disertante_editar', {id: disertante.id}) }}" class="btn btn-warning btn-sm">✏️ Editar</a>
                    <form method="post"
                          action="{{ path('admin_disertante_borrar', {id: disertante.id}) }}"
                          class="d-inline"
                          onsubmit="return confirm('¿Seguro que desea eliminar este disertante?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('borrar' ~ disertante.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️ Borrar</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No existe ningún disertante.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('admin_disertante_nuevo') }}" class="btn btn-success">➕ Nuevo Disertante</a>
</div>

{% endblock %}