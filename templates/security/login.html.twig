{% extends 'base.html.twig' %}

{% block title %}Ingreso Administrador{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-6 col-lg-5">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h1 class="h3 text-center mb-2">
                        Gestión de Eventos
                    </h1>

                    <p class="text-center text-secondary mb-4">
                        Ingreso Administrador
                    </p>

                    {% if error %}
                        <div class="alert alert-danger">
                            Credenciales incorrectas.
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info">
                            Sesión iniciada como
                            <strong>{{ app.user.userIdentifier }}</strong>.

                            <a href="{{ path('app_logout') }}">
                                Cerrar sesión
                            </a>
                        </div>
                    {% endif %}

                    <form method="post"
                          action="{{ path('app_login') }}">

                        <div class="mb-3">

                            <label for="username"
                                   class="form-label">
                                Correo electrónico
                            </label>

                            <input
                                type="email"
                                name="_username"
                                id="username"
                                value="{{ last_username }}"
                                class="form-control"
                                placeholder="admin@eventos.com"
                                autocomplete="email"
                                required
                                autofocus
                            >

                        </div>

                        <div class="mb-4">

                            <label for="password"
                                   class="form-label">
                                Contraseña
                            </label>

                            <input
                                type="password"
                                name="_password"
                                id="password"
                                class="form-control"
                                placeholder="Ingresá tu contraseña"
                                autocomplete="current-password"
                                required
                            >

                        </div>

                        <input
                            type="hidden"
                            name="_csrf_token"
                            value="{{ csrf_token('authenticate') }}"
                        >

                        <button
                            type="submit"
                            class="btn btn-primary w-100">
                            Ingresar
                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <a href="{{ path('app_portada') }}"
                           class="text-decoration-none">
                            ← Volver al inicio
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}