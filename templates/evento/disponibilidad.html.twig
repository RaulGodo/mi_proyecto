{% extends 'base.html.twig' %}

{% block title %}Disponibilidad - {{ evento.titulo }}{% endblock %}

{% block body %}
    <h1>{{ evento.titulo }}</h1>

    <p>{{ mensaje }}</p>

    <p>Capacidad: {{ evento.capacidad }}</p>

    <a href="{{ path('app_evento_detalle', {slug: evento.slug}) }}">Volver al evento</a>
{% endblock %}