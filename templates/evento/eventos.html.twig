{% extends 'frontend/layout.html.twig' %}

{% block title %}
    Eventos
{% endblock %}

{% block contenido %}

<h2>Listado de Eventos</h2>

{% for evento in eventos %}

<div class="mb-4">

    <strong>
        {{ evento.hora|date('H:i') }}
        -
        {{ evento.horaFinalizacion|date('H:i') }}
    </strong>

    <br>

    <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}">
        {{ evento.titulo|title }}
    </a>

    <p>
        {{ evento.descripcion|slice(0,150) }}...
    </p>

</div>

{% else %}

    <p>No hay eventos disponibles.</p>

{% endfor %}

{% endblock %}
