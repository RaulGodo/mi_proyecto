{% extends 'frontend/layout.html.twig' %}

{% block title %}Patrocinadores{% endblock %}

{% block contenido %}

<section class="py-4">

    <h1 class="mb-4">Patrocinadores</h1>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h2 class="h5 mb-3">
                Instituciones que acompañan nuestros eventos
            </h2>

            <p class="text-secondary mb-0">
                En esta sección se mostrará información sobre
                las instituciones, empresas u organizaciones
                que acompañan los eventos publicados
                en el Sistema de Gestión de Eventos.
            </p>

        </div>

    </div>

</section>

{% endblock %}